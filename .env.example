# Flask session signing. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=

# Encrypts BYO API keys, Gmail OAuth tokens, and other stored secrets.
# Keep this stable after deployment; changing it makes existing encrypted data unreadable.
INTERNSHIP_AGENT_SECRET_KEY=

# Optional locally. Required for hosted multi-user deployments.
# Supabase Postgres URLs should include sslmode=require.
INTERNSHIP_AGENT_DATABASE_URL=

# Hosted Google OAuth web client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exact deployed origin, no trailing slash.
# Example: https://internship-agent.onrender.com
PUBLIC_BASE_URL=
